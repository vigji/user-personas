# Copy to .env and fill in. .env is gitignored: secrets live only on this
# machine and are passed to the pod per-session over SSH, never written to
# disk on the server (no `huggingface-cli login` on the pod — it stores the
# token in the HF cache; the sync/run scripts pass HF_TOKEN as an env var).

# RunPod pod SSH — filled automatically by scripts/pod_deploy.sh, or by hand
# from the pod's Connect panel ("SSH over exposed TCP")
POD_ID=
POD_SSH_HOST=
POD_SSH_PORT=
POD_SSH_USER=root

# Hugging Face token — needed only for gated models (gemma-2, llama-3.3).
# The Qwen3-0.6B mock needs none.
HF_TOKEN=

# Needed by scripts/pod_deploy.sh & pod_destroy.sh (REST API); not needed if
# managing pods in the web UI
RUNPOD_API_KEY=
